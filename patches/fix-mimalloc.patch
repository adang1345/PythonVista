diff --git a/Objects/mimalloc/prim/windows/prim.c b/Objects/mimalloc/prim/windows/prim.c
--- a/Objects/mimalloc/prim/windows/prim.c
+++ b/Objects/mimalloc/prim/windows/prim.c
@@ -18,6 +18,43 @@ terms of the MIT license. A copy of the license can be found in the file
 #define MI_WIN_DESKTOP  1
 #endif
 
+//---------------------------------------------
+// TryAcquireSRWLockExclusive() for Windows Vista
+//---------------------------------------------
+
+// TryAcquireSRWLockExclusive() requires Windows 7+. Internally, bit 0 of an
+// SRWLOCK is the exclusive lock bit, and the fast path of
+// AcquireSRWLockExclusive() atomically sets it and succeeds if it was
+// previously clear. (This was discovered by inspecting the assembly
+// instructions in ntdll.dll.) On Windows 7+, TryAcquireSRWLockExclusive() is
+// that fast path without a fallback to the slow path. Replicate this behavior
+// here.
+static BOOLEAN WINAPI mi_TryAcquireSRWLockExclusive_vista(PSRWLOCK SRWLock) {
+#ifdef _WIN64
+  return !_interlockedbittestandset64((LONG64 volatile*)&SRWLock->Ptr, 0);
+#else
+  return !_interlockedbittestandset((LONG volatile*)&SRWLock->Ptr, 0);
+#endif
+}
+
+// Look up TryAcquireSRWLockExclusive() on first use. This is thread-safe
+// because the function pointer is read and written atomically, and every
+// thread stores the same value.
+static BOOLEAN WINAPI mi_TryAcquireSRWLockExclusive_resolve(PSRWLOCK SRWLock) {
+  mi_TryAcquireSRWLockExclusive_t func = NULL;
+  HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+  if (kernel32) {
+    func = (mi_TryAcquireSRWLockExclusive_t)(void (*)(void))GetProcAddress(kernel32, "TryAcquireSRWLockExclusive");
+  }
+  if (!func) {
+    func = mi_TryAcquireSRWLockExclusive_vista;
+  }
+  mi_atomic_store_release(&_mi_TryAcquireSRWLockExclusive, (uintptr_t)func);
+  return func(SRWLock);
+}
+
+_Atomic(uintptr_t) _mi_TryAcquireSRWLockExclusive = MI_ATOMIC_VAR_INIT((uintptr_t)mi_TryAcquireSRWLockExclusive_resolve);
+
 //---------------------------------------------
 // Dynamically bind Windows API points for portability
