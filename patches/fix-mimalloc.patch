diff --git a/Objects/mimalloc/prim/windows/prim.c b/Objects/mimalloc/prim/windows/prim.c
--- a/Objects/mimalloc/prim/windows/prim.c
+++ b/Objects/mimalloc/prim/windows/prim.c
@@ -8,11 +8,78 @@ terms of the MIT license. A copy of the license can be found in the file
 // This file is included in `src/prim/prim.c`
 
 #include "mimalloc.h"
+#include "mimalloc/atomic.h"
 #include "mimalloc/internal.h"
 #include "mimalloc/prim.h"
 #include <stdio.h>   // fputs, stderr
 #include <stdlib.h>  // atexit
 
+bool (*mi_lock_try_acquire)(mi_lock_t* lock);
+void (*mi_lock_acquire)(mi_lock_t* lock);
+void (*mi_lock_release)(mi_lock_t* lock);
+void (*mi_lock_init)(mi_lock_t* lock);
+void (*mi_lock_done)(mi_lock_t* lock);
+
+// implementation of lock using SRWLOCK
+typedef BOOLEAN (WINAPI *TryAcquireSRWLockExclusive_func)(PSRWLOCK SRWLock);
+static TryAcquireSRWLockExclusive_func mi_TryAcquireSRWLockExclusive;
+static bool mi_lock_try_acquire_srw(mi_lock_t* lock) {
+  return mi_TryAcquireSRWLockExclusive(&lock->srw);
+}
+static void mi_lock_acquire_srw(mi_lock_t* lock) {
+  AcquireSRWLockExclusive(&lock->srw);
+}
+static void mi_lock_release_srw(mi_lock_t* lock) {
+  ReleaseSRWLockExclusive(&lock->srw);
+}
+static void mi_lock_init_srw(mi_lock_t* lock) {
+  InitializeSRWLock(&lock->srw);
+}
+static void mi_lock_done_srw(mi_lock_t* lock) {
+  (void)(lock);
+}
+
+// implementation of lock using CRITICAL_SECTION
+static bool mi_lock_try_acquire_cs(mi_lock_t* lock) {
+  return TryEnterCriticalSection(&lock->cs);
+}
+static void mi_lock_acquire_cs(mi_lock_t* lock) {
+  EnterCriticalSection(&lock->cs);
+}
+static void mi_lock_release_cs(mi_lock_t* lock) {
+  LeaveCriticalSection(&lock->cs);
+}
+static void mi_lock_init_cs(mi_lock_t* lock) {
+  InitializeCriticalSection(&lock->cs);
+}
+static void mi_lock_done_cs(mi_lock_t* lock) {
+  DeleteCriticalSection(&lock->cs);
+}
+
+// Initialize the lock implementation. Use SRWLOCK on Windows 7+. Use
+// CRITICAL_SECTION on Windows Vista.
+void _mi_prim_lock_init(void) {
+  HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+  const char* kind;
+  if (kernel32 && (mi_TryAcquireSRWLockExclusive = (TryAcquireSRWLockExclusive_func)GetProcAddress(kernel32, "TryAcquireSRWLockExclusive")) != NULL) {
+    mi_lock_try_acquire = mi_lock_try_acquire_srw;
+    mi_lock_acquire = mi_lock_acquire_srw;
+    mi_lock_release = mi_lock_release_srw;
+    mi_lock_init = mi_lock_init_srw;
+    mi_lock_done = mi_lock_done_srw;
+    kind = "SRWLOCK";
+  } else {
+    mi_lock_try_acquire = mi_lock_try_acquire_cs;
+    mi_lock_acquire = mi_lock_acquire_cs;
+    mi_lock_release = mi_lock_release_cs;
+    mi_lock_init = mi_lock_init_cs;
+    mi_lock_done = mi_lock_done_cs;
+    kind = "CRITICAL_SECTION";
+  }
+  _mi_options_lock_init();  // must call before any message output, which uses out_buf_lock
+  _mi_verbose_message("_mi_prim_lock_init: %s\n", kind);
+}
+
